{
  "name": "tally-effects",
  "version": "0.2.0",
  "description": "A composable, source-driven status effect framework for deriving and replicating gameplay state.",
  "license": "MIT",
  "author": "TimScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaDerpDuck/tally"
  },
  "bugs": {
    "url": "https://github.com/DaDerpDuck/tally/issues"
  },
  "homepage": "https://github.com/DaDerpDuck/tally#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "status-effects",
    "effects",
    "gameplay-effects",
    "state-management",
    "modifiers",
    "attributes",
    "stats",
    "buffs",
    "debuffs",
    "typescript",
    "game-development",
    "gameplay",
    "replication"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typetest": "tsc --noEmit && tsc -p benchmarks/tsconfig.json",
    "bench": "node --import tsx benchmarks/run.ts",
    "bench:repeat": "node --import tsx benchmarks/repeat.ts",
    "bench:compare": "node --import tsx benchmarks/compare.ts",
    "bench:scenarios": "node --import tsx benchmarks/run.ts scenarios",
    "bench:duplication": "node --import tsx benchmarks/run.ts duplication",
    "bench:lifecycle": "node --import tsx benchmarks/run.ts lifecycle",
    "bench:resolution": "node --import tsx benchmarks/run.ts resolution",
    "bench:replication": "node --import tsx benchmarks/run.ts replication",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"benchmarks/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"benchmarks/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tinybench": "^6.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
